{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "noEmit": true,
    "alwaysStrict": true, // Force strict mode in emitted code ("use strict")
    "declaration": true, // Generate .d.ts declaration files
    "exactOptionalPropertyTypes": false, // Distinguish undefined from missing optional properties
    "forceConsistentCasingInFileNames": true, // Catch casing mismatches in imports
    "isolatedDeclarations": false, // Require explicit types on exported values
    "isolatedModules": true, // Every file must be a standalone module
    "noFallthroughCasesInSwitch": true, // Forbid fallthrough in switch cases
    "noImplicitAny": true, // Forbid implicit any
    "noImplicitOverride": true, // Require override keyword when overriding base members
    "noImplicitReturns": true, // Require explicit returns on all code paths
    "noImplicitThis": true, // Forbid implicit any this
    "noPropertyAccessFromIndexSignature": false, // Allow dot access on index signature properties
    "strict": true, // Enable all strict type-checking options
    "strictBindCallApply": true, // Strict bind/call/apply parameter checks
    "strictFunctionTypes": true, // Strict function parameter variance
    "strictNullChecks": true, // Strict null/undefined checks
    "noUncheckedIndexedAccess": true, // Index access returns T | undefined
    "noUncheckedSideEffectImports": true, // Side-effect imports must resolve
    "useUnknownInCatchVariables": true, // Catch clause variables are unknown
    "verbatimModuleSyntax": true // Strict module syntax (type-only imports must use `type`)
  }
}
